# =============================================================================
# DOCKER DEPLOY — copy into .env on the server (docker compose)
# Guide + post-deploy checklist: docs/DEPLOY-DOCKER.md
# Env file map: docs/ENV.md
# =============================================================================
# Docker deploy — copy values into .env on the server (never commit .env).
#
# Single-port layout: users open MINOS_PUBLIC_ORIGIN; nginx proxies /api to Gunicorn.
# Rebuild web after changing MINOS_PUBLIC_ORIGIN: docker compose build web --no-cache

# Public URL (no trailing slash). Use the LAN IP colleagues open in the browser.
MINOS_PUBLIC_ORIGIN=http://10.20.52.20

# CORS — must match MINOS_PUBLIC_ORIGIN (same origin when using nginx proxy)
FRONTEND_ORIGIN=http://10.20.52.20

# Local Fedora test only (MINOS_PUBLIC_ORIGIN=http://localhost):
# REACT_APP_ALLOW_LOCALHOST_API=true

# Dev server auth bypass (not for production)
FLASK_APP=run.py
FLASK_ENV=development
AUTH_DISABLED=true
DEV_MOCK_ROLE=ADMIN

SECRET_KEY=replace_with_openssl_rand_hex_32

# Required at startup (mail not used when AUTH_DISABLED; placeholders are fine)
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@localhost
MAIL_MAX_EMAILS=10

# Host Mongo/Redis (VM services — not in Docker)
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DBNAME=minos_db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 0.0.0.0 so web container reaches API via host.docker.internal; ufw must block LAN :5000
GUNICORN_BIND=0.0.0.0
PORT=5000
BEHIND_PROXY=true
