# =============================================================================
# CRA npm run build — SSO staging SPA (manual/CI)
# Docker dev/test server: use .env.docker.example — docs/ENV.md
# =============================================================================
# CRA staging build — copy to .env.staging or CI vars for staging deploy (I4)
# Register these exact HTTPS URLs in the IdP before go-live (docs/SSO_REDIRECT_URIS.md)

REACT_APP_SSO_LOGIN_URL=https://idp.example.com/oauth2/authorize?client_id=minos-spa-staging&redirect_uri=https://minos-staging.example.com/home

REACT_APP_API_URL=https://api-staging.minos.example.com

REACT_APP_SSO_LOGOUT_URL=https://idp.example.com/oauth2/logout?client_id=minos-spa-staging&post_logout_redirect_uri=https://minos-staging.example.com/

# API host .env (not baked into SPA):
# FRONTEND_ORIGIN=https://minos-staging.example.com
