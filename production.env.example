# API production environment template (I5) — copy to server .env
# Do NOT set AUTH_DISABLED in production or staging.

FLASK_ENV=production
SECRET_KEY=replace_with_openssl_rand_hex_32

MONGO_URI=mongodb://user:pass@mongo-host:27017/
MONGO_DBNAME=minos_db

FRONTEND_ORIGIN=https://minos.example.com
BEHIND_PROXY=true

# SSO (required when AUTH_DISABLED is unset)
SSO_ISSUER=https://idp.example.com/realms/minos
SSO_AUDIENCE=minos-api
SSO_JWKS_URL=https://idp.example.com/realms/minos/protocol/openid-connect/certs
SSO_ROLES_CLAIM=roles
SSO_ROLE_ADMIN=minos-admin
SSO_ROLE_USER=minos-user

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

ALLOW_REGISTRATION=false

# Gunicorn (I6) — optional overrides
# PORT=5000
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
