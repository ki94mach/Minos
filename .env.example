# Copy to .env and replace placeholders — never commit real secrets (C7).
# Safe to commit: this file, .env.development, .env.production.example

# Flask config
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change_me_use_openssl_rand_hex_32

# Legacy Minos registration (B2) — disabled when FLASK_ENV=production
# ALLOW_REGISTRATION=false
# ALLOW_REGISTRATION=true

# SPA origin(s) for CORS — comma-separated (S6)
FRONTEND_ORIGIN=http://localhost:3000
# CORS_SUPPORTS_CREDENTIALS=true

# MongoDB (used by utils/config_utils.py -> models/meta.py connect_db)
MONGO_URI=mongodb://localhost:27017/
MONGO_DBNAME=minos_db

# Redis — session store for /auth/* (app_factory.py reads REDIS_HOST/PORT/PASSWORD/DB)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_if_required
REDIS_DB=0
# Optional URL form (no real credentials in repo):
# REDIS_URL=redis://localhost:6379/0
SESSION_LIFETIME_HOURS=24

# Email config
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER=your_email@example.com

# SSO JWT validation (S3) — required when AUTH_DISABLED is not set
# SSO_ISSUER=https://idp.example.com/realms/minos
# SSO_AUDIENCE=minos-api
# SSO_JWKS_URL=https://idp.example.com/realms/minos/protocol/openid-connect/certs
# SSO_JWT_ALGORITHMS=RS256

# SSO role mapping (S2) — override when IdP values differ
SSO_ROLES_CLAIM=roles
SSO_ROLE_ADMIN=minos-admin
SSO_ROLE_USER=minos-user

# Local dev only (S4): skip SSO and inject a fake user on /api/*
# Requires FLASK_ENV=development (or any value except "production").
# App REFUSES TO START if AUTH_DISABLED=true and FLASK_ENV=production.
# AUTH_DISABLED=true
# DEV_MOCK_SUB=dev-user
# DEV_MOCK_EMAIL=dev@local
# DEV_MOCK_ROLE=ADMIN

# --- Frontend (CRA) — loaded by npm start / npm run build ---
# Local dev default is in .env.development (REACT_APP_API_URL=http://localhost:5000)
# REACT_APP_API_URL=http://localhost:5000
# Production/staging: set in .env.production before npm run build (see .env.production.example)
# REACT_APP_SSO_LOGIN_URL=https://idp.example.com/oauth2/authorize?...
# REACT_APP_SSO_LOGOUT_URL=https://idp.example.com/oauth2/logout
# REACT_APP_USE_MINOS_AUTH=true
# Force Minos /auth/login in a production build (local testing only)