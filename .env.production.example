# CRA production build (npm run build) — copy to .env.production
# Required for S5: unauthenticated users go to IdP, not /auth/login

REACT_APP_SSO_LOGIN_URL=https://idp.example.com/oauth2/authorize?client_id=minos-spa&redirect_uri=https://minos.example.com/home

# API server (.env on Flask host) — must match the deployed SPA origin
# FRONTEND_ORIGIN=https://minos.example.com

# Required for C2 / F10 — baked into the static build at compile time
REACT_APP_API_URL=https://api.minos.example.com

# Optional
# REACT_APP_SSO_LOGOUT_URL=https://idp.example.com/oauth2/logout

# Staging example:
# REACT_APP_API_URL=https://api-staging.minos.example.com
