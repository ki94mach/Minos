# =============================================================================
# CRA npm start only — committed defaults (no secrets). Not used by Flask/Docker.
# Pair with API .env from .env.example (AUTH_DISABLED=true). docs/DEV_SMOKE.md
# =============================================================================
# CRA dev defaults — safe to commit (no secrets). Loaded by npm start.
PORT=3000
REACT_APP_API_URL=http://localhost:5000

# No SSO / Minos login UI — use with API AUTH_DISABLED=true (docs/DEV_SMOKE.md)
REACT_APP_USE_MINOS_AUTH=false

# Overview root patient (F6) — optional; otherwise lookup by type + name
# REACT_APP_DEFAULT_CHAR_ID=
# REACT_APP_DEFAULT_CHAR_TYPE=Population
# REACT_APP_DEFAULT_CHAR_NAME=Iran

# SSO logout when REACT_APP_USE_MINOS_AUTH=false (F8)
# REACT_APP_SSO_LOGOUT_URL=https://idp.example.com/oauth2/logout
